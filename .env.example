# Copy to `.env` (repo root) for local development. Never commit `.env`.
# On Render, set these in each service's Environment tab (render.yaml wires most of them).

# ---------------------------------------------------------------- backend (FastAPI)
# Render injects this from the PostgreSQL database. postgres:// URLs are accepted.
DATABASE_URL=postgresql+psycopg://ja:ja@localhost:5432/jerusalem_apartments
# Long random string used to sign admin sessions. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# development | production  (production enables secure cookies and hides /docs)
ENVIRONMENT=development
# Public URL(s) of the Next.js site, comma separated. Used for CORS.
FRONTEND_URL=http://localhost:3000
# Optional: public URL of this API (defaults to RENDER_EXTERNAL_URL on Render, or the request URL).
PUBLIC_API_URL=

# Cloudinary (production image storage). If empty, images are stored on local disk (dev only).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=jerusalem-apartments
MAX_UPLOAD_MB=10

# Used as defaults for the site settings row and by `python -m app.scripts.create_admin`.
ADMIN_EMAIL=
WHATSAPP_NUMBER=

# ---------------------------------------------------------------- frontend (Next.js)
# Public URL of the FastAPI backend. Read at build time on Render.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Public URL of this site (for sitemap.xml, canonical and Open Graph URLs). Falls back to RENDER_EXTERNAL_URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
